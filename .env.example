# ============================================================================
# FinAI Decision Intelligence — environment template
# Copy to .env and fill in. Matches the Environment Variables Reference table
# in implementation_plan_Final.md (as amended by Amendment 7).
# For local dev, `python scripts/generate_dev_keys.py` fills the key material.
# ============================================================================

ENV=development

# PostgreSQL — the RUNNING APP connects THROUGH PgBouncer (host port 6432,
# transaction pooling) as the NON-superuser role `app_user`. This is a SECURITY
# requirement: a superuser silently bypasses Row-Level Security, so the app must
# NOT connect as `finai`. `app_user` is created by migration 0007.
#   * App (this var):  app_user via PgBouncer on 6432
#   * Alembic:         `finai` DIRECT to Postgres (host 5433) — see ALEMBIC_DATABASE_URL
#                      in scripts/dev-env.ps1; migrations need superuser/owner rights.
DATABASE_URL=postgresql://app_user:app_user@localhost:6432/finai
#
# NATIVE SETUP (no Docker, see DEMO.md): Postgres runs as a Windows service on
# 5432 and there is no PgBouncer, so point both URLs straight at 5432:
#   DATABASE_URL=postgresql://app_user:<APP_DB_PASSWORD>@localhost:5432/finai
#   ALEMBIC_DATABASE_URL=postgresql://finai:<finai password>@localhost:5432/finai
# Use letters and digits only in these passwords, or URL-encode them.

# Password for the least-privilege app_user login role. Read by migration 0007
# when it CREATE/ALTERs the role, and must match the app_user credentials above.
# Default 'app_user' is fine for local dev; set a real secret in production.
APP_DB_PASSWORD=app_user

# Superuser/owner connection Alembic migrates with (never used by the app).
# Read from the environment, not .env — run migrations through
# scripts/with_env.py, which exports .env first.
ALEMBIC_DATABASE_URL=postgresql://finai:finai@localhost:5433/finai

# Redis (local compose; Upstash rediss:// URL in production)
REDIS_URL=redis://localhost:6379/0

# RS256 key pair — raw PEM, \n-escaped PEM, or base64-encoded PEM string.
# Generate for local dev with: python scripts/generate_dev_keys.py
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Fernet key — urlsafe-base64 from cryptography.fernet.Fernet.generate_key()
# (NOT hex — Amendment 7). Encrypts TOTP secrets and future Kite tokens.
FERNET_KEY=

# Anthropic Claude (debate engine — Milestone 3)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MONTHLY_BUDGET_USD=50.00

# Target email for budget and system warnings
ADMIN_EMAIL=admin@example.com

# Resend transactional email. Empty while ENV=development = emails are
# printed to the server log instead of being sent (Amendment 6).
RESEND_API_KEY=

# Base URL used in email links and auth redirects
FRONTEND_URL=http://localhost:3000

# Google OAuth. Create a Web-application OAuth client in the Google Cloud
# Console; while these are empty, GET /v1/auth/google/login returns 503
# "Google login not configured" (clean degradation).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Authorized redirect URI registered with Google. Empty = derived from the
# request as {base_url}/v1/auth/google/callback (fine for local dev on :8000).
GOOGLE_OAUTH_REDIRECT_URI=

# Sentry (empty = disabled)
SENTRY_DSN=

# Zerodha Kite — DEFERRED (Amendment 1). kite_tokens table kept in schema.
ZERODHA_KITE_API_KEY=
ZERODHA_KITE_API_SECRET=

# CORS allowed origins (JSON array)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# ---- Analysis pipeline / SSE (§3F, Milestone 3) ---------------------------
# How long GET /v1/decisions/{id}/stream stays open before emitting a `timeout`
# event and closing (§3F specifies 2 minutes).
# SSE_STREAM_TIMEOUT_SECONDS=120
# Keepalive comment frame interval, so proxies don't drop an idle stream.
# SSE_HEARTBEAT_SECONDS=15
# TTL on sse_log:{decision_id}, the replayable event backlog a reconnecting
# client reads before subscribing.
# SSE_BACKLOG_TTL_SECONDS=3600
# Until Phase 5 registers the real ML steps, the pipeline runs transparent
# placeholders so the flow is exercisable end-to-end. Set false to make an
# unregistered step a hard failure instead.
# PIPELINE_STUB_STEPS=true

# ---- Market data + simulation (Phase 5, migration 0008) --------------------
# Capture live NIFTY/VIX (yfinance) when a decision is submitted. A failed or
# disabled fetch stores NULLs and the model uses neutral market defaults.
# MARKET_DATA_ENABLED=true
# MARKET_DATA_TIMEOUT_SECONDS=8
# Monte Carlo paths per HOLD/SELL leg.
# SIMULATION_PATHS=1000
# Bias classifier: v4 (action- and portfolio-aware, calibrated) or v3 (rollback).
# BIAS_MODEL_VERSION=v4
# Simulation: v2 (your horizon, real history, tax) or v1 (fixed 20 years, rollback).
# SIMULATOR_VERSION=v2
# Phase B3: let investors who opt in have Gemini read their comment and word
# the case for holding and selling. Needs GEMINI_API_KEY (see EXPLAINER_LLM_*).
# AI_HELP=false

# ---- Local tuning knobs (optional; safe defaults shown) --------------------
# RATE_LIMIT_ENABLED=true
# BLACKLIST_CACHE_TTL_SECONDS=0    # set ~60 in production (Amendment 10 / Upstash quota)
# EMAIL_FROM=FinAI <onboarding@resend.dev>

# ---- Explanations: optional LLM wording polish (GAP 3) ---------------------
# Fully functional without this. Templates are authoritative; the LLM may only
# reword, and any polish that changes a number is discarded before display.
# Free key: https://aistudio.google.com/apikey
EXPLAINER_LLM=off
# EXPLAINER_LLM=on
# GEMINI_API_KEY=
# EXPLAINER_LLM_PROVIDER=gemini          # or: openai_compat
# EXPLAINER_LLM_MODEL=gemini-flash-lite-latest
# EXPLAINER_LLM_TIMEOUT=30
# EXPLAINER_LLM_BASE_URL=https://api.x.ai/v1   # openai_compat only
# EXPLAINER_LLM_API_KEY=                       # openai_compat only
