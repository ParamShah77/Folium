# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — your real key never enters the repository.
# ─────────────────────────────────────────────────────────────────────

# ── GAP 3: optional LLM fluency polish for explanations ──────────────
# The system is fully functional without this. Templates are the
# authoritative path; the LLM only rewords, and any polish that alters a
# number is discarded before the user sees it.
#
# Get a free key: https://aistudio.google.com/apikey

EXPLAINER_LLM=off
# EXPLAINER_LLM=on
# GEMINI_API_KEY=your-key-here

# Optional overrides
# EXPLAINER_LLM_PROVIDER=gemini          # or: openai_compat
# EXPLAINER_LLM_MODEL=gemini-flash-lite-latest
#
# Free-tier quotas are per model and are small. Measured on 2026-08-23:
#   gemini-3.6-flash        5 requests/min, 20 requests/DAY  (often times out
#                           on the longest section)
#   gemini-flash-lite-latest  its own quota pool, ~1.5s responses  <- default
#
# One explanation costs exactly ONE request (all six sections travel together,
# and the year-by-year table is never sent to the model).
# EXPLAINER_LLM_TIMEOUT=30

# For an OpenAI-shaped endpoint instead (Grok, OpenRouter, local server):
# EXPLAINER_LLM_PROVIDER=openai_compat
# EXPLAINER_LLM_BASE_URL=https://api.x.ai/v1
# EXPLAINER_LLM_API_KEY=your-key-here

# ── Backend location used by the Streamlit dashboard ─────────────────
# API_BASE_URL=http://localhost:8000
