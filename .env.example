# ============================================================================
# FinAI Decision Intelligence — environment template
# Copy to .env and fill in. Matches the Environment Variables Reference table
# in implementation_plan_Final.md (as amended by Amendment 7).
# For local dev, `python scripts/generate_dev_keys.py` fills the key material.
# ============================================================================

ENV=development

# PostgreSQL. Local compose: the app connects THROUGH PgBouncer (port 6432,
# transaction pooling); Alembic and tests may use Postgres directly on 5432.
DATABASE_URL=postgresql://finai:finai@localhost:6432/finai

# Redis (local compose; Upstash rediss:// URL in production)
REDIS_URL=redis://localhost:6379/0

# RS256 key pair — raw PEM, \n-escaped PEM, or base64-encoded PEM string.
# Generate for local dev with: python scripts/generate_dev_keys.py
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Fernet key — urlsafe-base64 from cryptography.fernet.Fernet.generate_key()
# (NOT hex — Amendment 7). Encrypts TOTP secrets and future Kite tokens.
FERNET_KEY=

# Anthropic Claude (debate engine — Milestone 3)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MONTHLY_BUDGET_USD=50.00

# Target email for budget and system warnings
ADMIN_EMAIL=admin@example.com

# Resend transactional email. Empty while ENV=development = emails are
# printed to the server log instead of being sent (Amendment 6).
RESEND_API_KEY=

# Base URL used in email links and auth redirects
FRONTEND_URL=http://localhost:3000

# Google OAuth (Milestone 2)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Sentry (empty = disabled)
SENTRY_DSN=

# Zerodha Kite — DEFERRED (Amendment 1). kite_tokens table kept in schema.
ZERODHA_KITE_API_KEY=
ZERODHA_KITE_API_SECRET=

# CORS allowed origins (JSON array)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# ---- Local tuning knobs (optional; safe defaults shown) --------------------
# RATE_LIMIT_ENABLED=true
# BLACKLIST_CACHE_TTL_SECONDS=0    # set ~60 in production (Amendment 10 / Upstash quota)
# EMAIL_FROM=FinAI <onboarding@resend.dev>
